<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4" main_tree_to_execute="BehaviorTree">
  <!-- Coordinates live in RMUL2027_semantic_map.yaml. -->
  <BehaviorTree ID="BehaviorTree">
    <ReactiveSequence>
      <SubGameStatus topic_name="/feedback_game_progress" game_progress="{game_progress}"/>
      <SubRobotStatus topic_name="/feedback_robot_hp" feedback_robot_hp="{feedback_robot_hp}"/>
      <GetCurrentPose current_pose="{current_pose}"/>
      <GetCurrentRegion current_pose="{current_pose}" region="{current_region}"/>
      <WhileDoElse>
        <IsGameTime message="{game_progress}" game_progress="4"/>
        <WhileDoElse>
          <IsRetreat message="{feedback_robot_hp}" hp_threshold_retreat="110" hp_threshold_recover="400"/>
          <SubTree ID="LockedSemanticTask" task_type="return_supply"
                   target_region="red_supply_zone" target_pose_id="red_supply" _autoremap="true"/>
          <Sequence>
            <SubTree ID="LockedSemanticTask" task_type="go_center"
                     target_region="center_zone" target_pose_id="center_staging" _autoremap="true"/>
          </Sequence>
        </WhileDoElse>
        <AlwaysSuccess/>
      </WhileDoElse>
    </ReactiveSequence>
  </BehaviorTree>

  <!-- A task transition halts this decorator and unlocks the route. While the
       same task is active, Resolve/SelectSemanticRoute execute only once and
       the selected normal/tunnel route remains fixed through completion. -->
  <BehaviorTree ID="LockedSemanticTask">
    <RunOnceUntilHalted>
      <SubTree ID="RunSemanticTask" _autoremap="true"/>
    </RunOnceUntilHalted>
  </BehaviorTree>

  <BehaviorTree ID="RunSemanticTask">
    <Sequence>
      <ResolveFieldPose semantic_pose="{target_pose_id}" goal_pose="{task_goal}"/>
      <SelectSemanticRoute current_region="{current_region}" target_region="{target_region}"
                           task_type="{task_type}" route_id="{route_id}"
                           edge_list="{route_edges}" route_type="{route_type}"
                           controller="{route_controller}"
                           uses_tunnel="{uses_tunnel}" preparation_goal="{tunnel_preparation}"
                           entry_path="{tunnel_entry_path}" tunnel_path="{tunnel_path}"/>
      <SubTree ID="ExecuteSemanticRoute" _autoremap="true"/>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="ExecuteSemanticRoute">
    <IfThenElse>
      <IsTunnelRoute uses_tunnel="{uses_tunnel}"/>
      <Sequence>
        <SubTree ID="TraverseTunnel" _autoremap="true"/>
        <!-- Only the post-tunnel normal edge uses the global planner. -->
        <SelectController controller_id="position_goal_checker" topic_name="/goal_checker_selector"/>
        <SendGoal goal_pose="{task_goal}" action_name="/navigate_to_pose" move="false" length="1.0"/>
      </Sequence>
      <Sequence>
        <SelectController controller_id="position_goal_checker" topic_name="/goal_checker_selector"/>
        <SendGoal goal_pose="{task_goal}" action_name="/navigate_to_pose" move="false" length="1.0"/>
      </Sequence>
    </IfThenElse>
  </BehaviorTree>

  <BehaviorTree ID="TraverseTunnel">
    <RetryUntilSuccessful num_attempts="2">
      <Sequence>
        <SelectController controller_id="FollowPath" topic_name="/controller_selector"/>
        <!-- Preparation remains the only NavigateToPose goal that requires
             heading alignment before entering the narrow approach. -->
        <SelectController controller_id="general_goal_checker" topic_name="/goal_checker_selector"/>
        <Timeout msec="12000">
          <SendGoal goal_pose="{tunnel_preparation}" action_name="/navigate_to_pose" move="false" length="1.0"/>
        </Timeout>
        <Timeout msec="10000">
          <FollowTunnelPath path="{tunnel_entry_path}" action_name="/follow_path"
                            controller_id="FollowPath" goal_checker_id="tunnel_handoff_checker"/>
        </Timeout>
        <!-- From here traversal is committed: no global planner and no Spin. -->
        <Fallback>
          <Sequence>
            <Timeout msec="30000">
              <FollowTunnelPath path="{tunnel_path}" action_name="/follow_path"
                                controller_id="TunnelController" goal_checker_id="tunnel_handoff_checker"/>
            </Timeout>
            <SelectController controller_id="FollowPath" topic_name="/controller_selector"/>
          </Sequence>
          <Sequence>
            <!-- Use the one root CurrentPose snapshot; do not create another
                 TF listener inside the recovery branch. -->
            <BuildTunnelRetreatPath current_pose="{current_pose}" tunnel_path="{tunnel_path}"
                                    preparation_goal="{tunnel_preparation}"
                                    retreat_path="{tunnel_retreat_path}"/>
            <Timeout msec="30000">
              <FollowTunnelPath path="{tunnel_retreat_path}" action_name="/follow_path"
                                controller_id="TunnelController" goal_checker_id="tunnel_handoff_checker"/>
            </Timeout>
            <SelectController controller_id="FollowPath" topic_name="/controller_selector"/>
            <AlwaysFailure/>
          </Sequence>
          <Sequence>
            <SelectController controller_id="FollowPath" topic_name="/controller_selector"/>
            <AlwaysFailure/>
          </Sequence>
        </Fallback>
      </Sequence>
    </RetryUntilSuccessful>
  </BehaviorTree>
</root>
