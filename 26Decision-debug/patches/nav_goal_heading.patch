 namespace teb_local_planner
 {
 
+// Track chassis heading independently from translation/path tangent.
+class EdgeGoalHeading : public BaseTebUnaryEdge<1, double, VertexPose>
+{
+public:
+  void computeError() override
+  {
+    const auto * pose = static_cast<const VertexPose *>(_vertices[0]);
+    _error[0] = g2o::normalize_theta(pose->theta() - _measurement);
+  }
+};
+
